# OmniRoute Configuration
# Copy this file to .env and fill in your actual values

# OmniRoute server base URL
ANTHROPIC_BASE_URL=http://localhost:20128

# Your OmniRoute authentication token
ANTHROPIC_AUTH_TOKEN=your-omniroute-auth-token-here

# Model name configured in OmniRoute
ANTHROPIC_MODEL=deepak-ai

# ── Telegram Bot Integration ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_ID=your-telegram-user-id-here

# ── Email Integration (IMAP + App Password) ───────────────────────────────
# Provider: gmail | outlook | yahoo | custom
EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=you@gmail.com
# Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Override IMAP/SMTP servers for custom providers (auto-set for gmail/outlook/yahoo)
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587

# ── YouTube Data API (for video/playlist metadata) ────────────────────────
# Free API key: https://console.cloud.google.com/ -> Enable "YouTube Data API v3"
YOUTUBE_API_KEY=AIzaSy...your-key-here
